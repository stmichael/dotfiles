// -*- mode: jsonc -*-
{
  "position": "top",
  "height": 38,
  "spacing": 0,

  "modules-left": [
    "group/sound",
    "group/input"
  ],
  "modules-center": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "group/connection",
    "custom/cups",
    "custom/disks",
    "group/power",
    "clock"
  ],

  "group/sound": {
    "orientation": "horizontal",
    "modules": [
      "pulseaudio",
      "mpris"
    ]
  },

  "group/input": {
    "orientation": "horizontal",
    "modules": [
      "hyprland/language",
      "hyprland/submap"
    ]
  },

  "group/connection": {
    "orientation": "horizontal",
    "modules": [
      "bluetooth",
      "custom/vpn",
      "network"
    ]
  },

  "group/power": {
    "orientation": "horizontal",
    "modules": [
      "cpu",
      "backlight",
      "battery",
      "power-profiles-daemon"
    ]
  },

  "hyprland/workspaces": {
    "format": "{id}",
    "format-icons": {
      "default": "",
      "active": ""
    },
    "active-only": true,
    "all-outputs": false
  },
  "hyprland/submap": {
    "format": " {}"
  },
  "mpris": {
    "format": "{status_icon}",
    "title-len": 30,
    "artist-len": 15,
    "status-icons": {
      "playing": "",
      "paused": "",
      "stopped": ""
    },
    "dynamic-order": ["title", "artist"]
  },
  "pulseaudio": {
    "format": " {volume}% {format_source}",
    "format-muted": " 0% {format_source}",
    "format-source": " {volume}%",
    "format-source-muted": " 0%",
    "on-click": "$TERMINAL -e ncpamixer -t o"
  },
  "bluetooth": {
    "format-off": "󰂲",
    "format-on": "󰂯",
    "format-connected": "󰂱 {device_battery_percentage}%",
    "tooltip-format": "{num_connections} devices connected",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_battery_percentage}%",
    "on-click": "$TERMINAL -e bluetuith"
  },
  "cpu": {
    "format": " {usage}%",
    "tooltip": false
  },
  "memory": {
    "format": " {}%"
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "{icon} {percent}%",
    "format-icons": ["", "", "", "", "", "", "", "", ""]
  },
  "battery": {
    "interval": 20,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-full": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-alt": "{time} {icon}",
    "format-icons": ["", "", "", "", ""]
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },
  "network": {
    "format-wifi": " {essid}",
    "format-ethernet": " {ipaddr}",
    "format-linked": " {ifname} (No IP)",
    "format-disconnected": "⚠ Disconnected"
  },
  "custom/vpn": {
    "format": "{}",
    "return-type": "json",
    "exec": "$HOME/.config/waybar/modules/nordvpn.sh",
    "interval": 10
  },
  "clock": {
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format": "{:%Y-%m-%d %H:%M}"
  },
  "custom/cups": {
    "format": " {}",
    "return-type": "json",
    "exec": "$HOME/.config/waybar/modules/cups.sh",
    "interval": 20,
    "tooltip": true
  },
  "custom/disks": {
    "format": "󱇰 {}",
    "return-type": "json",
    "exec": "$HOME/.config/waybar/modules/disks.sh get",
    "interval": 10,
    "tooltip": false,
    "menu": "on-click",
    "menu-file": "$HOME/.config/waybar/modules/disk-menu.xml",
    "menu-actions": {
      "eject": "$HOME/.config/waybar/modules/disks.sh eject"
    }
  }
}
