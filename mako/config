max-history=5
max-visible=5
history=1
sort=-time
default-timeout=10000
ignore-timeout=0

on-button-left=invoke-default-action
on-button-middle=dismiss-group
on-button-right=dismiss
on-touch=invoke-default-action
on-notify=exec mpv /usr/share/sounds/freedesktop/stereo/message.oga

layer=top
anchor=top-right

font=Roboto 10
format= <b>%s</b>\n%b
text-alignment=left

icons=1
max-icon-size=34
icon-location=left
actions=1

outer-margin=0
margin=10
padding=10
border-size=0
border-radius=3

include=~/.config/mako/colors.conf
