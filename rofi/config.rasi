configuration {
  modes: "combi,window,drun,app-groups,nordvpn,calc,workspaces";
  threads: 0; /* autodetect threading */
  case-sensitive: false;
  terminal: "rofi-sensible-terminal";
  click-to-exit: true;
  steal-focus: false;

  /* Display */
  font: "Roboto 10";
  show-icons: true;
  scroll-method: 0; /* per page */
  cycle: true;
  sort: false;
  fixed-num-lines: true;
  sidebar-mode: false;
  m: "-4"; /* show on monitor with the focused window */

  display-window: "";
  display-app-groups: "";
  display-drun: "";
  display-nordvpn: "󰢭";
  display-calc: "󰪚";
  display-workspaces: "󰍹";
  display-combi: "All";

  /* timeout */
  timeout {
      action: "kb-cancel";
      delay:  5;
  }

  /* Selection */
  hover-select: false;
  auto-select: false;

  /* Matching */
  matching: "normal";
  tokenize: true;
  normalize-match: true;

  /* Combi */
  combi-modes: "window,drun,app-groups,nordvpn,workspaces";
  combi-hide-mode-prefix: false;
  combi-display-format: "{text}";

  /* history */
  disable-history: false;
  max-history-size: 25;

  /* drun */
  drun-match-fields: "name,generic,exec,categories,keywords";
  drun-categories: "";
  drun-show-actions: false;
  drun-display-format: "{name} [<span weight='light' size='small'><i>({generic})</i></span>]";
  drun-url-launcher: "xdg-open";
  drun-use-desktop-cache: false;
  drun-reload-desktop-cache: false;
  drun {
    /** Parse user desktop files. */
    parse-user:   true;
    /** Parse system desktop files. */
    parse-system: true;
  }

  /* window */
  window-match-fields: "all";
  window-format: "{c} {t}";
  window-thumbnail: false;

  /* keybindings */
  kb-mode-next: "Control+Page_Down";
  kb-mode-previous: "Control+Page_Up";
  kb-row-left: "";
  kb-row-right: "";
}

@theme "theme"
